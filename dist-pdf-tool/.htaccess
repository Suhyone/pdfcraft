AddType application/wasm .wasm
AddType text/javascript .js

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/wasm application/json
</IfModule>

<IfModule mod_headers.c>
  # Build files carry a content hash in their name, so they never change under the same name.
  <FilesMatch "\.(wasm|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # These two keep fixed names and must always be re-checked.
  <FilesMatch "^(index\.html|bridge\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
